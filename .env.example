# Settings for `sparkshift upload` (pip install 'sparkshift[databricks]').
#
# Copy this file to .env (git ignores it), fill in your own values, and load
# it into your shell before uploading; the Databricks SDK reads environment
# variables, not this file:
#
#     set -a; . ./.env; set +a
#
# Or skip this file and use a profile in ~/.databrickscfg with --profile.
# Never commit a token, paste it into an issue, or pass it on the command line.

# Your workspace URL, such as https://dbc-1234abcd-5678.cloud.databricks.com
DATABRICKS_HOST=

# A personal access token (User settings > Developer > Access tokens).
DATABRICKS_TOKEN=
